@model List<ExerciciosASP_NET_CORE_MVC.Models.Evento>

@{
    ViewData["Title"] = "Lista de Eventos";
}

<h2>Lista de Eventos</h2>

<p>
    <a asp-action="Criar" class="btn btn-success">Novo Evento</a>
    <a asp-action="Buscar" class="btn btn-outline-primary">Buscar</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum evento cadastrado ainda.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Local</th>
                <th>Data</th>
                <th>Vagas</th>
                <th>Valor do Ingresso</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evento in Model)
            {
                <tr>
                    <td>@evento.Id</td>
                    <td>@evento.Nome</td>
                    <td>@evento.Descricao</td>
                    <td>@evento.Local</td>
                    <td>@evento.DataEvento?.ToString("dd/MM/yyyy")</td>
                    <td>@evento.QuantidadeVagas</td>
                    <td>@evento.ValorIngresso?.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}